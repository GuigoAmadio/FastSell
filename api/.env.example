# Database
DATABASE_URL="postgresql://fastsell:fastsell@127.0.0.1:15432/fastsell?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# App
PORT=3000
APP_URL="http://localhost:3000"
MOBILE_RESET_DEEP_LINK="fastsell://reset-password"
FRONTEND_RESET_URL="http://localhost:3000/reset-password"
# App web do Flutter (rode com: flutter run -d edge --web-port 5050)
WEB_APP_URL="http://localhost:5050"
CORS_ORIGINS="*"

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FastSell <noreply@fastsell.local>"

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
RESET_TOKEN_TTL_HOURS=24

# US04: bloqueio por IP (contas/e-mails variados a partir do mesmo IP)
LOGIN_IP_MAX_ATTEMPTS=20
# Só ligue atrás de um proxy reverso confiável (usa X-Forwarded-For como IP do cliente)
TRUST_PROXY=0

# US08: worker da fila de notificações (BullMQ no Redis). 0 = não processa neste processo
NOTIFICATIONS_WORKER=1

# US15: frete via Melhor Envio. Sem token/CEP de origem a API responde 503 SHIPPING_NOT_CONFIGURED
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENV=sandbox
MELHOR_ENVIO_USER_AGENT="FastSell (seu-email@exemplo.com)"
STORE_ORIGIN_CEP=

# US06: onde ficam as imagens (avatar, produtos, avaliações)
# local = pasta api/uploads (padrão) | s3 = bucket S3 ou compatível (AWS, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Só para provedores compatíveis (R2/MinIO). Vazio = AWS.
S3_ENDPOINT=
# URL pública das imagens (ex.: domínio do CDN). Vazio = endereço padrão do bucket.
S3_PUBLIC_URL=
